      "topic": "zeichen-und-verbote",
      "estimatedSeconds": 45,
      "instructionDe": "Lesen Sie den Text. Prüfen Sie die Aussage: „Sie dürfen hier rauchen.“ Richtig oder falsch?",
      "instructionTranslations": {
        "en": "Read the text. Check the statement: “You are allowed to smoke here.” Right or wrong?",
        "pl": "Przeczytaj tekst. Sprawdź stwierdzenie: „Sie dürfen hier rauchen.“ Prawda czy fałsz?"
      },
      "explanation": {
        "en": "The text forbids smoking (\"Bitte rauchen Sie nicht.\"), so the statement is falsch. It says nothing about buying cigarettes.",
        "pl": "Tekst zabrania palenia (\"Bitte rauchen Sie nicht.\"), więc stwierdzenie jest fałszywe. O kupowaniu papierosów nie ma mowy."
      },
      "assetIds": [
        "txt-p1-rauchen"
      ],
      "answerKey": {
        "type": "trueFalse",
        "expected": "falsch"
      },
      "hints": [
        {
          "level": "translation",
          "text": "The statement says you are allowed to smoke here."
        }
      ],
      "errorTags": [
        "sign-reading"
      ],
      "review": {
        "status": "draft",
        "note": "Acceptance sample from blueprint §3; language review pending (task 4.x)."
      }
    },
